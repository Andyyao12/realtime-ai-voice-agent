# Shared LiveKit credentials. Replace every example value locally.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-a-long-random-secret

# Internal Agent connection and public browser/Anam connection.
LIVEKIT_URL=ws://livekit:7880
PUBLIC_LIVEKIT_URL=wss://rtc.example.com
AGENT_NAME=showcase-voice-agent
AGENT_HEALTH_PORT=8081
# Optional outbound proxy for OpenAI HTTP/WebSocket calls.
OPENAI_HTTP_PROXY=

# Realtime model. See https://developers.openai.com/api/docs/models/gpt-realtime-2.1
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Optional Avatar extension. The official LiveKit Anam plugin requires an avatar ID.
ANAM_API_KEY=
ANAM_AVATAR_ID=
# Kept as an account-side reference only; it is not sent by the public runtime.
ANAM_PERSONA_ID=
# Core voice runs without Avatar credentials; opt in only for P0.1 validation.
SHOWCASE_AVATAR_ENABLED=false

# Internal mock business service.
BUSINESS_API_URL=http://business-api:8000
DATABASE_URL=sqlite:////data/showcase.db
TOOL_TIMEOUT_SECONDS=5
MODEL_CONNECT_TIMEOUT_SECONDS=20

# Public deployment.
APP_DOMAIN=voice-agent.example.com
LIVEKIT_DOMAIN=rtc.example.com
CADDY_EMAIL=admin@example.com

# Optional cost-protection gate for POST /api/token.
SHOWCASE_ACCESS_CODE=
LOG_LEVEL=INFO
